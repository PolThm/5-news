---
// Story 4.1: the World / day / French default route, kept as its own
// dedicated fast-path entry point at `/` (Story 4.1's own AC1: "no
// client-side fetch required") -- Story 4.2 introduces the equivalent
// `/fr/world/day` as a separate, equally-valid direct-link target under
// the dynamic route; both are static files, so this costs nothing at
// build time. See that story's Dev Notes for the explicit decision.
//
// Nothing here calls an AI, embedding, ingestion, or third-party API -- at
// build time or request time (AD-1). The only input is the JSON the pipeline
// writes to data/briefings/ (AD-2), read once at build time below -- never
// fetched client-side.
import { join } from "node:path";
import BriefingPage from "../components/BriefingPage.astro";
import { loadBriefing } from "../lib/loadBriefing";

// import.meta.url is not safe to build paths from here: Astro bundles this
// module for prerendering, so at build time it resolves to a path under
// dist/, not this source file's real location. process.cwd() is stable --
// astro build/dev always run from site/, so the repo root is one level up.
const SITE_ROOT = process.cwd();
const REAL_PATH = join(SITE_ROOT, "..", "data", "briefings", "fr", "world", "day.json");
const FIXTURE_PATH = join(SITE_ROOT, "src", "fixtures", "day.json");

const briefing = loadBriefing(REAL_PATH, FIXTURE_PATH);
---

<BriefingPage briefing={briefing} lang="fr" zone="world" period="day">
  <div slot="extra-scripts">
    <script src="../islands/language-detect.ts"></script>
  </div>
</BriefingPage>
