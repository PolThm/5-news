---
// The shared render for a Briefing page -- extracted from Story 4.1's
// index.astro (Story 4.2, Task 1) so index.astro and the new
// [lang]/[zone]/[period].astro dynamic route render identically, with one
// place to keep in sync rather than two copies that could drift (mirrors
// this codebase's Python-side AD-12 discipline: one owner per rendering
// concern).
//
// zone/period/lang are passed separately from `briefing` (rather than
// read off `briefing.zone`/`briefing.period`/`briefing.language`)
// because the *route*'s addressing is what the mad-libs word hrefs must
// target -- for a Continent-fallback Zone (a future story's concern),
// `briefing.served_zone` could differ from the Zone this page is actually
// addressed at, and the link must always point at the requested route,
// not wherever the fallback happened to serve content from.
import {
  attributionText,
  consensusChipText,
  countryLabel,
  discardedVolumeText,
  endScreenText,
  fallbackNoticeText,
  formatCount,
  hasValidAttribution,
  madLibsLeadIn,
  nextPeriod,
  nextZone,
  OUTPUT_LANGUAGE_CYCLE,
  periodSentenceText,
  sourceListIntro,
  timestampPrefix,
  zoneSentenceLabel,
} from "../lib/briefing";
import type { BriefingRecord, OutputLanguage, Period } from "../lib/briefing";

interface Props {
  briefing: BriefingRecord;
  lang: OutputLanguage;
  zone: string;
  period: Period;
}

const { briefing, lang, zone, period } = Astro.props;

const nextPeriodHref = `/${lang}/${zone}/${nextPeriod(period)}`;
// Built from the *route's* zone prop (what was requested), never
// briefing.served_zone -- see this file's own header comment above on why
// a Continent-fallback page's Zone link must always advance from the
// requested Zone, not wherever the fallback happened to serve content from.
const nextZoneHref = `/${lang}/${nextZone(zone)}/${period}`;
const fallbackNotice = fallbackNoticeText(briefing, lang);
const endScreenStatement = endScreenText(briefing.clusters.length, period, lang);
const consensusText = consensusChipText(lang);
const attribution = attributionText(lang);
const discardedText = discardedVolumeText(lang);

// See index.astro's own history for why this is UTC-labeled, not silently
// implied-local: this page has no client JS at build/initial-render time
// capable of knowing a reader's real timezone.
function formatTimestamp(iso: string): string {
  const date = new Date(iso);
  const hours = String(date.getUTCHours()).padStart(2, "0");
  const minutes = String(date.getUTCMinutes()).padStart(2, "0");
  return `${timestampPrefix(lang)} ${hours}:${minutes} UTC`;
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>5 News</title>
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1f4d3d" />
    <style>
      /*
        Governed by: DESIGN.md (Colors, Typography, Layout & Spacing,
        Shapes, Components) and EXPERIENCE.md (Information Architecture,
        State Patterns: "Cold load", Accessibility Floor).
      */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        background: #faf9f6;
        color: #1a1a18;
        font-family: "IBM Plex Sans", Arial, sans-serif;
        font-size: 15px;
        line-height: 1.5;
      }
      .page {
        max-width: 680px;
        margin: 0 auto;
        padding: 0 16px;
      }
      @media (min-width: 720px) {
        .page {
          padding: 0 48px;
        }
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 0 12px;
        border-bottom: 1px solid #e7e4dc;
      }
      .mark {
        font-weight: 600;
        font-size: 13px;
        letter-spacing: 0.08em;
      }
      /* Story 4.7: real, independently-clickable <a> elements (one per
         supported language), not a cycling mad-libs word -- see
         period-switcher.ts's own comment on why this needs its own
         click-handling shape. The visible text stays exactly as small as
         before; padding (not font-size) grows the invisible hit area to
         the 44x44px minimum (EXPERIENCE.md Accessibility Floor). The
         active language is marked by both color AND aria-current (not
         color alone -- EXPERIENCE.md: "the active Output Language is
         both colored *and* marked current... not color alone"). A "·"
         separator (CSS ::after, not a DOM text node) renders between
         entries without needing a conditional last-child exception. */
      .lang {
        display: flex;
        align-items: center;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
      }
      .lang a {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        min-height: 44px;
        padding: 0 4px;
        color: #777265;
        text-decoration: none;
      }
      .lang a.active {
        color: #1f4d3d;
      }
      .lang a:not(:last-child)::after {
        content: "·";
        margin-left: 8px;
        color: #777265;
      }
      /* Story 4.8 (AC1): a visible :focus-visible ring on every
         interactive element -- reuses the existing `primary` accent
         (#1f4d3d), which clears 3:1 contrast against every background
         this page uses (9.12:1 on the page background, 8.12:1 on the
         collapsed chip, 7.40:1 on the expanded chip/source-list), so no
         new color is introduced. :focus-visible, not bare :focus, so a
         mouse click doesn't show a ring -- only keyboard/programmatic
         focus does. */
      .lang a:focus-visible {
        outline: 2px solid #1f4d3d;
        outline-offset: 2px;
      }
      .sentence-block {
        padding: 24px 0 8px;
      }
      h1 {
        font-family: "Source Serif 4", Georgia, serif;
        font-weight: 500;
        font-size: 28px;
        line-height: 1.25;
        color: #1a1a18;
      }
      /* .word applies to both mad-libs words (Zone and Period, both real
         <a> elements as of Story 4.3) -- the dotted underline must look
         identical for both, and must not pick up a browser's default solid
         link-underline styling (DESIGN.md's explicit "dotted, not solid"
         distinction from attribution links). */
      h1 .word {
        color: #1f4d3d;
        text-decoration: underline dotted 2px;
        text-decoration-color: #8fc2ac;
        text-underline-offset: 3px;
      }
      h1 a.word {
        text-decoration-line: underline;
      }
      .word:focus-visible {
        outline: 2px solid #1f4d3d;
        outline-offset: 2px;
      }
      /* Exact values from mockups/briefing-fallback.html -- `secondary`
         (#8a3a2b text on #f6dcd4 background) is reserved for exactly this
         one meaning (DESIGN.md Colors) and must never appear anywhere else
         on the page. */
      .fallback-notice {
        margin-top: 10px;
        padding: 10px 12px;
        font-size: 14px;
        color: #8a3a2b;
        background: #f6dcd4;
        border-radius: 3px;
      }
      .timestamp {
        margin-top: 8px;
        font-size: 13px;
        color: #4d4a42;
      }
      .item-list {
        padding: 8px 0 0;
      }
      .item {
        padding: 24px 0;
        border-bottom: 1px solid #e7e4dc;
      }
      .item:last-of-type {
        border-bottom: none;
      }
      .item p.summary {
        font-family: "Source Serif 4", Georgia, serif;
        font-size: 19px;
        line-height: 1.5;
        color: #1a1a18;
        margin-bottom: 12px;
      }
      /* .chip is a real <button> (native keyboard/Enter/Space activation,
         aria-expanded semantics for free) -- these overrides strip the
         browser's default button chrome so it reads identically to Story
         4.1's original <span>. `border: none` doesn't touch `outline`,
         but nothing here relied on the browser's own default outline
         rendering visibly either -- Story 4.8 adds an explicit
         :focus-visible rule below rather than assuming it. */
      .chip {
        display: inline-block;
        border: none;
        cursor: pointer;
        font-family: "IBM Plex Mono", "Courier New", monospace;
        font-size: 14px;
        font-weight: 500;
        background: #eeece5;
        color: #1a1a18;
        border-radius: 3px;
        padding: 4px 10px;
        margin-bottom: 10px;
      }
      .chip:focus-visible {
        outline: 2px solid #1f4d3d;
        outline-offset: 2px;
      }
      .chip .num {
        color: #1f4d3d;
      }
      /* The chevron rotates 180deg when expanded -- the only visible
         "this is clickable" affordance (neither mockup drafted one beyond
         an invisible cursor: pointer). No new color: reuses .chip's own
         text color. */
      .chip .chevron {
        display: inline-block;
        margin-left: 4px;
        transition: transform 0.15s ease;
      }
      .chip[aria-expanded="true"] {
        background: #dde2ee;
        margin-bottom: 0;
        border-radius: 3px 3px 0 0;
      }
      .chip[aria-expanded="true"] .chevron {
        transform: rotate(180deg);
      }
      /* Present in the initial server-rendered HTML always (a no-JS reader
         sees this permanently expanded -- a legitimate degrade, not a
         bug); the client-side island hides it by default when JS is
         present and toggles visibility on chip click/Enter. Tertiary
         accent (DESIGN.md: "reserved for the Consensus Score's expanded
         source list") -- #dde2ee/#1a2438 are that token's container/
         on-container tints, matching the only drafted expanded-state
         mockup (briefing-fallback.html). */
      .source-list {
        margin-top: 0;
        margin-bottom: 10px;
        padding: 12px 14px;
        background: #dde2ee;
        border-radius: 0 0 3px 3px;
        font-size: 13px;
        color: #1a2438;
      }
      .source-list ul {
        margin-top: 6px;
        padding-left: 18px;
      }
      .source-list li {
        margin-bottom: 2px;
      }
      /* JS-present default: collapsed. Toggled by the client island
         removing/adding this class on chip click/Enter -- see
         period-switcher.ts's chip-toggle logic. */
      .source-list.js-collapsed {
        display: none;
      }
      .attribution {
        display: block;
        font-size: 13px;
        color: #4d4a42;
      }
      .attribution a {
        color: #1a1a18;
        text-decoration: underline;
        font-weight: 500;
      }
      .attribution a:focus-visible {
        outline: 2px solid #1f4d3d;
        outline-offset: 2px;
      }
      /* FR-8 -- always renders exactly once, even when both counts are 0
         (the real, currently-true state for every real pipeline Briefing
         today -- no pipeline stage populates non-zero values yet). Unlike
         the End Screen, there is no "suppress for zero" case here. */
      .discarded {
        padding: 20px 16px;
        font-size: 13px;
        color: #4d4a42;
        border-top: 1px solid #e7e4dc;
      }
      .discarded .num {
        font-family: "IBM Plex Mono", "Courier New", monospace;
        font-weight: 500;
        color: #1a1a18;
      }
      /* FR-5, UX-DR8 -- the one component whose entire job is to stop the
         page (EXPERIENCE.md). .rule is the outline-variant hairline;
         the <p> is the label-caps completion statement (uppercase applied
         here per the mockup -- the label-caps token itself doesn't encode
         case). Nothing renders after this element in the markup. */
      .end-screen {
        padding: 20px 0 32px;
        text-align: center;
      }
      .end-screen .rule {
        height: 1px;
        background: #cac5b8;
        margin-bottom: 16px;
      }
      .end-screen p {
        font-family: "IBM Plex Sans", Arial, sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #4d4a42;
      }
      /* Story 4.8 (AC2): visually hidden but always present, so a screen
         reader attached before any click already has something to
         observe. position:absolute + clip (NOT display:none/
         visibility:hidden) -- some screen readers ignore aria-live
         updates on an element hidden either of those two ways. */
      #sr-announcer {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header>
        <div class="mark">5 NEWS</div>
        <div class="lang" id="lang-control">
          {
            OUTPUT_LANGUAGE_CYCLE.map((candidateLang) => (
              <a
                class={candidateLang === lang ? "active" : ""}
                aria-current={candidateLang === lang ? "true" : undefined}
                data-lang-word
                data-target-lang={candidateLang}
                data-lang={lang}
                data-zone={zone}
                data-period={period}
                href={`/${candidateLang}/${zone}/${period}`}
              >
                {candidateLang.toUpperCase()}
              </a>
            ))
          }
        </div>
      </header>

      <div class="sentence-block" id="sentence-block">
        <h1 id="mad-libs-sentence">
          {madLibsLeadIn(lang)} <a
            class="word"
            data-zone-word
            data-lang={lang}
            data-zone={zone}
            data-period={period}
            href={nextZoneHref}>{zoneSentenceLabel(zone, lang)}</a
          >, <a
            class="word"
            data-period-word
            data-lang={lang}
            data-zone={zone}
            data-period={period}
            href={nextPeriodHref}>{periodSentenceText(period, lang)}</a
          >.
        </h1>
        {
          fallbackNotice && (
            <div class="fallback-notice" id="fallback-notice">
              {fallbackNotice}
            </div>
          )
        }
        <div class="timestamp" id="timestamp">{formatTimestamp(briefing.generated_at)}</div>
      </div>

      <div class="item-list" id="item-list">
        {
          briefing.clusters.map((cluster) => (
            <div class="item">
              {cluster.summary && <p class="summary">{cluster.summary}</p>}
              <button
                type="button"
                class="chip"
                aria-expanded="false"
                aria-controls={`source-list-${cluster.cluster_id}`}
                data-consensus-chip
              >
                <span class="num">{cluster.independent_source_count}</span> {consensusText.sources}{" "}
                · <span class="num">{cluster.country_count}</span> {consensusText.countries}
                <span class="chevron" aria-hidden="true">
                  ▾
                </span>
              </button>
              <div class="source-list" id={`source-list-${cluster.cluster_id}`}>
                {sourceListIntro(lang)}
                <ul>
                  {cluster.members.map((member) => (
                    <li>
                      {member.source} ({countryLabel(member.source_country, lang)})
                    </li>
                  ))}
                </ul>
              </div>
              {hasValidAttribution(cluster) && (
                <span class="attribution">
                  {attribution.reportedBy} <em>{cluster.outbound_source}</em> —{" "}
                  <a href={cluster.outbound_url} target="_blank" rel="noopener noreferrer">
                    {attribution.readOriginal}
                  </a>
                </span>
              )}
            </div>
          ))
        }
      </div>

      <div class="discarded" id="discarded">
        <span class="num">{formatCount(briefing.discarded_ingested, lang)}</span> {discardedText.reviewed}{" "}
        → <span class="num">{formatCount(briefing.discarded_kept, lang)}</span> {discardedText.kept}
      </div>

      {
        endScreenStatement && (
          <div class="end-screen" id="end-screen">
            <div class="rule" />
            <p>{endScreenStatement}</p>
          </div>
        )
      }
    </div>
    <div id="sr-announcer" aria-live="polite"></div>
    <script src="../islands/period-switcher.ts"></script>
    <slot name="extra-scripts" />
  </body>
</html>
