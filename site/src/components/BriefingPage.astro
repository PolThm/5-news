---
// The shared render for a Briefing page -- extracted from Story 4.1's
// index.astro (Story 4.2, Task 1) so index.astro and the new
// [lang]/[zone]/[period].astro dynamic route render identically, with one
// place to keep in sync rather than two copies that could drift (mirrors
// this codebase's Python-side AD-12 discipline: one owner per rendering
// concern).
//
// zone/period/lang are passed separately from `briefing` (rather than
// read off `briefing.zone`/`briefing.period`/`briefing.language`)
// because the *route*'s addressing is what the mad-libs word hrefs must
// target -- for a Continent-fallback Zone (a future story's concern),
// `briefing.served_zone` could differ from the Zone this page is actually
// addressed at, and the link must always point at the requested route,
// not wherever the fallback happened to serve content from.
import { hasValidAttribution, nextPeriod, periodSentenceText } from "../lib/briefing";
import type { BriefingRecord, Period } from "../lib/briefing";

interface Props {
  briefing: BriefingRecord;
  lang: string;
  zone: string;
  period: Period;
}

const { briefing, lang, zone, period } = Astro.props;

const nextPeriodHref = `/${lang}/${zone}/${nextPeriod(period)}`;

// See index.astro's own history for why this is UTC-labeled, not silently
// implied-local: this page has no client JS at build/initial-render time
// capable of knowing a reader's real timezone.
function formatTimestamp(iso: string): string {
  const date = new Date(iso);
  const hours = String(date.getUTCHours()).padStart(2, "0");
  const minutes = String(date.getUTCMinutes()).padStart(2, "0");
  return `Mis à jour à ${hours}:${minutes} UTC`;
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>5 News</title>
    <style>
      /*
        Governed by: DESIGN.md (Colors, Typography, Layout & Spacing,
        Shapes, Components) and EXPERIENCE.md (Information Architecture,
        State Patterns: "Cold load", Accessibility Floor).
      */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        background: #faf9f6;
        color: #1a1a18;
        font-family: "IBM Plex Sans", Arial, sans-serif;
        font-size: 15px;
        line-height: 1.5;
      }
      .page {
        max-width: 680px;
        margin: 0 auto;
        padding: 0 16px;
      }
      @media (min-width: 720px) {
        .page {
          padding: 0 48px;
        }
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 0 12px;
        border-bottom: 1px solid #e7e4dc;
      }
      .mark {
        font-weight: 600;
        font-size: 13px;
        letter-spacing: 0.08em;
      }
      .lang {
        display: flex;
        gap: 10px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
      }
      .lang span {
        color: #777265;
      }
      .lang span.active {
        color: #1f4d3d;
      }
      .sentence-block {
        padding: 24px 0 8px;
      }
      h1 {
        font-family: "Source Serif 4", Georgia, serif;
        font-weight: 500;
        font-size: 28px;
        line-height: 1.25;
        color: #1a1a18;
      }
      /* .word applies to both the static <span> (Zone, not yet
         interactive -- Story 4.3) and the real <a> (Period, this story) --
         the dotted underline must look identical either way, and must not
         pick up a browser's default solid link-underline styling
         (DESIGN.md's explicit "dotted, not solid" distinction from
         attribution links). */
      h1 .word {
        color: #1f4d3d;
        text-decoration: underline dotted 2px;
        text-decoration-color: #8fc2ac;
        text-underline-offset: 3px;
      }
      h1 a.word {
        text-decoration-line: underline;
      }
      .timestamp {
        margin-top: 8px;
        font-size: 13px;
        color: #4d4a42;
      }
      .item-list {
        padding: 8px 0 0;
      }
      .item {
        padding: 24px 0;
        border-bottom: 1px solid #e7e4dc;
      }
      .item:last-of-type {
        border-bottom: none;
      }
      .item p.summary {
        font-family: "Source Serif 4", Georgia, serif;
        font-size: 19px;
        line-height: 1.5;
        color: #1a1a18;
        margin-bottom: 12px;
      }
      .chip {
        display: inline-block;
        font-family: "IBM Plex Mono", "Courier New", monospace;
        font-size: 14px;
        font-weight: 500;
        background: #eeece5;
        color: #1a1a18;
        border-radius: 3px;
        padding: 4px 10px;
        margin-bottom: 10px;
      }
      .chip .num {
        color: #1f4d3d;
      }
      .attribution {
        display: block;
        font-size: 13px;
        color: #4d4a42;
      }
      .attribution a {
        color: #1a1a18;
        text-decoration: underline;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header>
        <div class="mark">5 NEWS</div>
        <div class="lang" aria-hidden="true">
          <span class="active">FR</span><span>EN</span><span>ES</span>
        </div>
      </header>

      <div class="sentence-block" id="sentence-block">
        <h1 id="mad-libs-sentence">
          Voici ce qui se passe dans <span class="word">le Monde</span>, <a
            class="word"
            data-period-word
            data-lang={lang}
            data-zone={zone}
            data-period={period}
            href={nextPeriodHref}>{periodSentenceText(period)}</a
          >.
        </h1>
        <div class="timestamp" id="timestamp">{formatTimestamp(briefing.generated_at)}</div>
      </div>

      <div class="item-list" id="item-list">
        {
          briefing.clusters.map((cluster) => (
            <div class="item">
              {cluster.summary && <p class="summary">{cluster.summary}</p>}
              <span class="chip">
                <span class="num">{cluster.independent_source_count}</span> sources
                indépendantes · <span class="num">{cluster.country_count}</span> pays
              </span>
              {hasValidAttribution(cluster) && (
                <span class="attribution">
                  Rapporté par <em>{cluster.outbound_source}</em> —{" "}
                  <a href={cluster.outbound_url}>lire l'article original →</a>
                </span>
              )}
            </div>
          ))
        }
      </div>
    </div>
    <script src="../islands/period-switcher.ts"></script>
  </body>
</html>
