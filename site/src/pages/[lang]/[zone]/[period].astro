---
// The dynamic [lang]/[zone]/[period] route the architecture spine names
// explicitly (ARCHITECTURE-SPINE.md, Structural Seed). Story 4.2 built this
// for World/fr, all 3 Periods; Story 4.3 extended getStaticPaths()'s
// enumeration to all 15 Zones (45 combinations); Story 4.7 (Output
// Language) extends it a third time, to all 3 Languages (135 combinations
// total). This file's rendering logic below was already written generic
// across all three axes via BriefingPage.
//
// AD-1/AD-2: reads only data/briefings/ at build time, no client-side
// fetch, no AI/embedding/ingestion/third-party call.
import { join } from "node:path";
import BriefingPage from "../../../components/BriefingPage.astro";
import { loadBriefing } from "../../../lib/loadBriefing";
import { OUTPUT_LANGUAGE_CYCLE, ZONE_CYCLE, type OutputLanguage, type Period } from "../../../lib/briefing";

interface RouteParams {
  lang: OutputLanguage;
  zone: string;
  period: Period;
}

export function getStaticPaths(): { params: RouteParams }[] {
  // ZONE_CYCLE/OUTPUT_LANGUAGE_CYCLE are briefing.ts's own hand-mirrors of
  // pipeline.config's ZONES/OUTPUT_LANGUAGES (never imported directly --
  // scripts/check-boundary.sh forbids any site/ -> pipeline/
  // cross-reference); reused here rather than duplicating either list a
  // second time in this file, per Story 4.2's own "one owner, not
  // divergent copies" discipline.
  const periods: Period[] = ["day", "week", "month"];
  return OUTPUT_LANGUAGE_CYCLE.flatMap((lang) =>
    ZONE_CYCLE.flatMap((zone) => periods.map((period) => ({ params: { lang, zone, period } })))
  );
}

const { lang, zone, period } = Astro.params as RouteParams;

const SITE_ROOT = process.cwd();
const REAL_PATH = join(SITE_ROOT, "..", "data", "briefings", lang, zone, `${period}.json`);
const FIXTURE_PATH = join(SITE_ROOT, "src", "fixtures", `${period}.json`);

const briefing = loadBriefing(REAL_PATH, FIXTURE_PATH);
---

<BriefingPage briefing={briefing} lang={lang} zone={zone} period={period} />
